# ─────────────────────────────────────────────────────────────────
# Server Environment — copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local:      postgresql://postgres:password@localhost:5432/portfolio_db
# Supabase:   postgresql://postgres:[pw]@db.[project].supabase.co:5432/postgres
# Neon:       postgresql://[user]:[pw]@[host].neon.tech/[db]?sslmode=require
DATABASE_URL="postgresql://..."

# BetterAuth secret (32+ random chars) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"

# Where the API is served (BetterAuth uses this for callbacks)
BETTER_AUTH_URL="http://localhost:4000"

# React frontend origin (for CORS and cookie policy)
CLIENT_URL="http://localhost:5173"

# Express port
PORT=4000

# OpenAI API key (optional — AI returns mock data without this)
# OPENAI_API_KEY=sk-...

NODE_ENV=development
